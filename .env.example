# dotdl settings. Every variable is optional.
#
# The usual place for them is ~/.config/dotdl/config.env, which
# `dotdl config` edits. The DOTDL_* lines of a .env in the current folder are
# read too, and environment variables always take priority.

# Base output folder (default: the current folder). Used when -o is not
# given; a relative -o (e.g. -o music) goes inside it, and an absolute -o
# ignores it. A leading ~ is expanded.
#DOTDL_OUTPUT_DIR=~/Videos

# Cookies from a browser where you are logged in, in Netscape format (export
# them with an extension such as "Get cookies.txt LOCALLY"). They get past
# YouTube's "confirm you're not a bot" check, age restrictions and content
# behind a login.
#DOTDL_COOKIES_FILE=~/cookies.txt

# Folder for the downloads' temporary files (default: the system's).
#DOTDL_TEMP_DIR=/tmp

# JavaScript runtime yt-dlp uses for YouTube's challenges. Empty uses Deno
# (included in the Docker image; make deps installs it) or, without it, node.
#DOTDL_JS_RUNTIMES=node

# Log verbosity on stderr: debug | info | warn | error (default info).
#DOTDL_LOG_LEVEL=info
