#!/usr/bin/env bash
# dotdl (via Docker): runs dotdl in a container, with no yt-dlp, ffmpeg or
# deno on the host. `make install-docker` puts it on PATH as "dotdl".
#
#   dotdl video https://youtu.be/xxxx
#   dotdl audio -f m4a -o music https://youtu.be/xxxx
#   dotdl doctor
#
# The container runs as your user with your home mounted at the same path:
# ~, absolute paths and ~/.config/dotdl work as with the native install.
#
# Variables: DOTDL_IMAGE (default dotdl:latest) and dotdl's DOTDL_*.
set -euo pipefail

image=${DOTDL_IMAGE:-dotdl:latest}

docker_args=(run --rm -i --init
	--user "$(id -u):$(id -g)"
	-e HOME="$HOME"
	-v "$HOME:$HOME"
	-w "$PWD")

# The progress view needs a terminal, and the colors need to know which one.
if [ -t 0 ] && [ -t 1 ]; then
	docker_args+=(-t -e TERM="${TERM:-xterm-256color}")
	if [ -n "${COLORTERM:-}" ]; then
		docker_args+=(-e COLORTERM="$COLORTERM")
	fi
fi

# mount_same mounts a host path at the same place in the container, unless
# it is inside the home (already mounted) or mounted already.
#
# Colima's VM only sees the home by default: elsewhere the container gets an
# empty folder it cannot write to, so say so up front. OrbStack and Docker
# Desktop share more of macOS and need no warning.
mounted=$'\n'
colima=""
mount_same() {
	local path=$1
	case "$path" in "$HOME" | "$HOME"/*) return ;; esac
	case "$mounted" in *$'\n'"$path"$'\n'*) return ;; esac
	if [ -z "$colima" ]; then
		colima=no
		case "$(docker context show 2>/dev/null)" in colima*) colima=yes ;; esac
	fi
	if [ "$colima" = yes ]; then
		echo "dotdl: $path is outside your home, which Colima does not share by default" \
			"(add it under mounts in ~/.colima/default/colima.yaml)." >&2
	fi
	docker_args+=(-v "$path:$path")
	mounted+="$path"$'\n'
}

mount_same "$PWD"

# dotdl's variables set on the host apply inside too.
for var in DOTDL_OUTPUT_DIR DOTDL_COOKIES_FILE DOTDL_LOG_LEVEL DOTDL_JS_RUNTIMES; do
	if [ -n "${!var:-}" ]; then
		docker_args+=(-e "$var=${!var}")
	fi
done

# config_value reads KEY from a .env file (the last line wins), unquoted.
config_value() {
	local key=$1 file=$2 line value=""
	[ -r "$file" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in "$key="*) value=${line#*=} ;; esac
	done <"$file"
	case "$value" in \"*\") value=${value:1:-1} value=${value//\\\"/\"} value=${value//\\\\/\\} ;; esac
	# shellcheck disable=SC2088 # the ~ is literal here and expanded by hand
	case "$value" in "~" | "~/"*) value=$HOME${value:1} ;; esac
	printf '%s' "$value"
}

# setting returns a setting with dotdl's priority: environment, ./.env,
# then ~/.config/dotdl/config.env.
config_file=${XDG_CONFIG_HOME:-$HOME/.config}/dotdl/config.env
setting() {
	local key=$1 value=${!1:-}
	[ -n "$value" ] || value=$(config_value "$key" .env)
	[ -n "$value" ] || value=$(config_value "$key" "$config_file")
	printf '%s' "$value"
}

# The output and cookies folders must be mounted wherever they are set:
# otherwise a folder from config.env did not exist in the container.
output=$(setting DOTDL_OUTPUT_DIR)
if [ -n "$output" ] && mkdir -p "$output" 2>/dev/null; then
	mount_same "$(cd "$output" && pwd)"
fi
cookies=$(setting DOTDL_COOKIES_FILE)
if [ -n "$cookies" ] && [ -e "$cookies" ]; then
	mount_same "$(cd "$(dirname "$cookies")" && pwd)"
fi

# On WSL, the Windows drives (/mnt/c, /mnt/d…), so any folder there works.
if grep -qi microsoft /proc/version 2>/dev/null; then
	for drive in /mnt/[a-z]; do
		if [ -d "$drive" ]; then
			mount_same "$drive"
		fi
	done
fi

# Absolute paths in the arguments (-o, -a, --cookies and their values).
prev=""
for arg in "$@"; do
	value=$arg
	case "$arg" in --*=*) value=${arg#*=} ;; esac
	case "$value" in
	/*)
		case "$prev|${arg%%=*}" in
		-o\|* | --output\|* | *\|--output)
			mkdir -p "$value"
			mount_same "$value"
			;;
		*)
			if [ -e "$value" ]; then
				mount_same "$(dirname "$value")"
			fi
			;;
		esac
		;;
	esac
	prev=$arg
done

exec docker "${docker_args[@]}" "$image" "$@"
